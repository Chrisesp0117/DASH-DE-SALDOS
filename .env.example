# Google OAuth (usado pelo fluxo OAuth da página web E pelo Google Ads)
# Registre os redirect URIs no Google Cloud Console:
#   https://<seu-host>/api/auth/google/callback
CLIENT_ID=your-google-client-id.apps.googleusercontent.com
CLIENT_SECRET=your-google-client-secret
DEVELOPER_TOKEN=your-google-developer-token

# Fallback Google — usado apenas quando nenhuma conta Google está conectada
# na página de configurações web (/api/settings-ui)
REFRESH_TOKEN=your-google-refresh-token

# Meta OAuth (página web de configurações) — crie um app em
# developers.facebook.com (tipo Business), adicione o produto "Marketing API"
# e configure o redirect: https://<seu-host>/api/auth/meta/callback
META_APP_ID=your-meta-app-id
META_APP_SECRET=your-meta-app-secret

# Fallback Meta — usado apenas quando nenhuma conta Meta está conectada na web
META_TOKEN=your-meta-access-token

# Google Sheets Configuration (planilha de destino — escrita via service account)
SPREADSHEET_ID=your-spreadsheet-id
# Credenciais da service account: arquivo local OU JSON inline
# GOOGLE_APPLICATION_CREDENTIALS_JSON={"client_id":"...","private_key":"..."}

# Opcional: redirect URIs explícitos (default: derivados do host da request)
# GOOGLE_OAUTH_REDIRECT_URI=https://dash-de-saldos.vercel.app/api/auth/google/callback
# META_OAUTH_REDIRECT_URI=https://dash-de-saldos.vercel.app/api/auth/meta/callback

# Supabase (banco de dados — DATABASE + JOB_STATE + JOB_QUEUE + ACCOUNTS_CONFIG + APP_CONNECTIONS)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_KEY=eyJhbGc...
# SUPABASE_DATABASE_TABLE=database_rows  # opcional, padrão: database_rows
# SUPABASE_JOB_QUEUE_TABLE=job_queue        # opcional, padrão: job_queue
# SUPABASE_ACCOUNTS_TABLE=accounts_config   # opcional, padrão: accounts_config
# SUPABASE_CONNECTIONS_TABLE=app_connections # opcional, padrão: app_connections
# JOB_QUEUE_STALE_SECONDS=300               # opcional, default 5min para re-enfileirar running stale

# Cron security
CRON_SECRET=your-cron-secret

# Job execution tuning (optional - uses sensible defaults if not set)
# UPDATE_BATCH_SIZE=50           # Clients per batch (default: 50)
# UPDATE_MAX_ITERATIONS=10       # Max iterations per invocation (default: 10)
# CRON_MAX_RUNTIME_MS=150000     # Max runtime for cron (default: 150000 = 150s, must be < Vercel maxDuration)
# HEARTBEAT_INTERVAL_MS=20000    # Heartbeat interval (default: 20000 = 20s)
# HEARTBEAT_MISSED_COUNT=3       # Stale threshold (default: 3 missed heartbeats)

# Ajuste global de saldo do Meta (default: 13.85% — média histórica entre API e painel)
# META_GLOBAL_ADJUST_PCT=13.85

# Notes:
# - CLIENT_ID, CLIENT_SECRET, DEVELOPER_TOKEN: obtain from Google Cloud Console / Google Ads Manager Account
# - Conexões web: a página /api/settings-ui salva os tokens OAuth (Google Ads e Meta)
#   no Supabase (app_connections) e passa a usá-los automaticamente no lugar dos fallbacks.
# - REFRESH_TOKEN/META_TOKEN: continuam funcionando como fallback quando definidos.
# - SPREADSHEET_ID: ID from the URL of your Google Sheet (service account precisa de acesso)
# - CRON_SECRET: shared secret usado por Apps Script (e outros callers) para chamar os endpoints
#
# Setup Instructions:
# 1. Copy this file to .env
# 2. Rode o SQL em supabase_schema.sql no Supabase (inclui as tabelas novas da página web)
# 3. Configure as variáveis do Google/Meta acima (e os redirect URIs nos consoles)
# 4. Abra /api/settings-ui?secret=<CRON_SECRET> e conecte suas contas
# 5. Do NOT commit .env to version control (already in .gitignore)
